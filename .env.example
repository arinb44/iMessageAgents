# Claude (required) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Photon Spectrum cloud iMessage — from Settings at https://app.photon.codes
# Leave blank to run in the terminal chat UI instead.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Optional
# AGENT_NAME=Juno
# MODEL=claude-opus-5
# EFFORT=low            # low | medium | high
# TERMINAL=1            # also open the terminal UI when iMessage is on
# TYPING_DELAY=0        # send instantly instead of simulating typing
# DEBOUNCE_GROUP_MS=3000
# DEBOUNCE_DM_MS=1200
# DB_PATH=agent.db
